local isMinimized = false
local isVerifying = false
local isClosingSuccess = false

local function CopyLinkAction(titleLabel, rawLink, accentColor)
    local linkText = Trim(rawLink)
    if linkText == "" then
        linkText = "..."
    end

    local copied = false
    if type(setclipboard) == "function" then
        local ok = pcall(function()
            setclipboard(linkText)
        end)
        copied = ok
    end

    InfoStripText.TextColor3 = accentColor
    StatusLabel.TextColor3 = accentColor

    if copied then
        InfoStripText.Text = "Da sao chep " .. titleLabel .. ": " .. linkText
        StatusLabel.Text = "Status: Da sao chep"
        ShowRobloxToast(
            CONFIG.Name .. " - Da sao chep",
            "Da sao chep " .. titleLabel .. " vao bo nho tam",
            accentColor,
            2.5
        )
    else
        InfoStripText.Text = titleLabel .. ": " .. linkText
        StatusLabel.Text = "Status: Xem lien ket phia tren"
        ShowRobloxToast(
            CONFIG.Name .. " - Lien ket",
            titleLabel .. ": " .. linkText,
            accentColor,
            3.2
        )
    end
end

GetKeyFreeBtn.MouseButton1Click:Connect(function()
    CopyLinkAction("GetKey Free", CONFIG.Links.FreeKeyLink, Palette.CyanBright)
end)

BuyPremiumBtn.MouseButton1Click:Connect(function()
    CopyLinkAction("Buy Key Premium", CONFIG.Links.BuyPremiumLink, Palette.GoldBright)
end)

DiscordGroupBtn.MouseButton1Click:Connect(function()
    CopyLinkAction("Nhom Discord", CONFIG.Links.DiscordLink, Palette.DiscordGlow)
end)

MinimizeBtn.MouseButton1Click:Connect(function()
    if isClosingSuccess then return end
    isMinimized = not isMinimized
    if isMinimized then
        Body.Visible = false
        TweenService:Create(MainWindow, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            Size = UDim2.fromOffset(760, 44)
        }):Play()
    else
        local t = TweenService:Create(MainWindow, TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            Size = UDim2.fromOffset(760, 430)
        })
        t:Play()
        t.Completed:Connect(function()
            if not isMinimized and not isClosingSuccess then
                Body.Visible = true
            end
        end)
    end
end)

CloseBtn.MouseButton1Click:Connect(function()
    if isClosingSuccess then return end
    local t = TweenService:Create(MainWindow, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
        Size = UDim2.fromOffset(760, 360),
        BackgroundTransparency = 1
    })
    t:Play()
    t.Completed:Connect(function()
        if ScreenGui then
            ScreenGui:Destroy()
        end
    end)
end)

local function DismissGetKeyUiAndRunNext(tier, detailMsg, validKeyStr)
    isClosingSuccess = true

    if CONFIG.AutoLogin and validKeyStr then
        SaveVerifiedSession(validKeyStr)
    end

    ShowRobloxToast(
        CONFIG.Name .. " - Xac nhan thanh cong",
        tier .. " - " .. detailMsg,
        Palette.Success,
        3.0
    )

    task.wait(0.4)

    local closeTween = TweenService:Create(
        MainWindow,
        TweenInfo.new(0.24, Enum.EasingStyle.Back, Enum.EasingDirection.In),
        {
            Size = UDim2.fromOffset(680, 120),
            BackgroundTransparency = 1
        }
    )
    closeTween:Play()
    closeTween.Completed:Wait()

    if ScreenGui then
        ScreenGui:Destroy()
    end

    ExecuteNextScript()
end

VerifyBtn.MouseButton1Click:Connect(function()
    if isVerifying or isClosingSuccess then return end

    local entered = Trim(KeyBox.Text)
    if entered == "" or entered == "..." then
        StatusLabel.Text = "Status: Vui long nhap key..."
        StatusLabel.TextColor3 = Palette.Error
        ShowRobloxToast(
            CONFIG.Name .. " - Thong bao",
            "Ban chua nhap key hop le",
            Palette.Error,
            2.4
        )
        return
    end

    isVerifying = true
    VerifyLabel.Text = "VERIFYING..."
    StatusLabel.Text = "Status: Dang kiem tra..."
    StatusLabel.TextColor3 = Palette.CyanBright

    task.wait(0.5)

    local valid, tier, detailMsg = CheckKeyValid(entered)
    if valid then
        StatusLabel.Text = "Status: " .. detailMsg
        StatusLabel.TextColor3 = Palette.Success
        VerifyLabel.Text = "VERIFIED"
        DismissGetKeyUiAndRunNext(tier, detailMsg, entered)
    elseif tier == "EXPIRED" then
        ClearSavedSession()
        StatusLabel.Text = "Status: " .. detailMsg
        StatusLabel.TextColor3 = Palette.Error
        VerifyLabel.Text = "VERIFY KEY"
        ShowRobloxToast(
            CONFIG.Name .. " - Key het han",
            detailMsg .. " Vui long lay key moi",
            Palette.Error,
            3.0
        )
    else
        StatusLabel.Text = "Status: Key khong hop le"
        StatusLabel.TextColor3 = Palette.Error
        VerifyLabel.Text = "VERIFY KEY"
        ShowRobloxToast(
            CONFIG.Name .. " - Key khong hop le",
            "Key ban nhap khong dung Vui long thu lai",
            Palette.Error,
            2.8
        )
    end

    isVerifying = false
end)

