local function GetParentGui()
    if RunService:IsStudio() then
        return PlayerGui
    end
    local ok, hui = pcall(function()
        return gethui and gethui()
    end)
    return (ok and hui) or CoreGui or PlayerGui
end

local ParentGui = GetParentGui()

for _, name in ipairs({ "NHATCO_KEYSYSTEM_UI", "NHATCO_TOAST_UI" }) do
    local old = ParentGui:FindFirstChild(name)
    if old then
        old:Destroy()
    end
end

local function Create(class, props, parent)
    local inst = Instance.new(class)
    for k, v in pairs(props) do
        inst[k] = v
    end
    inst.Parent = parent
    return inst
end

local function AddCorner(parent, radius)
    return Create("UICorner", {
        CornerRadius = UDim.new(0, radius)
    }, parent)
end

local function AddLabel(parent, props)
    local defaults = {
        BackgroundTransparency = 1,
        TextColor3 = Palette.TextWhite,
        Font = Enum.Font.Gotham,
        TextSize = 14,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Center,
        BorderSizePixel = 0
    }
    for k, v in pairs(props) do
        defaults[k] = v
    end
    return Create("TextLabel", defaults, parent)
end

local function Trim(str)
    if type(str) ~= "string" then return "" end
    return str:match("^%s*(.-)%s*$")
end

local function HasValue(str)
    local c = Trim(str)
    return c ~= "" and c ~= "..."
end

local function CreateIconImage(parent, sizeOffset, pos, zIndex, cornerRadius)
    local holder = Create("Frame", {
        Size = UDim2.fromOffset(sizeOffset, sizeOffset),
        Position = pos,
        BackgroundColor3 = Palette.CardBg,
        BackgroundTransparency = 0.2,
        BorderSizePixel = 0,
        ClipsDescendants = true,
        ZIndex = zIndex or 2
    }, parent)
    AddCorner(holder, cornerRadius or 10)

    local img = Create("ImageLabel", {
        Size = UDim2.fromScale(0.88, 0.88),
        Position = UDim2.fromScale(0.06, 0.06),
        BackgroundTransparency = 1,
        Image = CONFIG.IconId,
        ScaleType = Enum.ScaleType.Fit,
        BorderSizePixel = 0,
        ZIndex = (zIndex or 2) + 1
    }, holder)
    AddCorner(img, math.max(6, (cornerRadius or 10) - 2))

    return holder, img
end

local function CreateActionCard(parent, title, tagText, size, pos, bgColor, tagColor, textColor)
    local cardBtn = Create("TextButton", {
        Size = size,
        Position = pos,
        BackgroundColor3 = bgColor,
        Text = "",
        AutoButtonColor = false,
        BorderSizePixel = 0,
        ClipsDescendants = true,
        ZIndex = 4
    }, parent)
    AddCorner(cardBtn, 12)

    AddLabel(cardBtn, {
        Text = tagText,
        Size = UDim2.new(1, -10, 0, 14),
        Position = UDim2.fromOffset(5, 7),
        Font = Enum.Font.GothamBold,
        TextSize = 9,
        TextXAlignment = Enum.TextXAlignment.Center,
        TextColor3 = tagColor,
        ZIndex = 5
    })

    AddLabel(cardBtn, {
        Text = title,
        Size = UDim2.new(1, -8, 0, 18),
        Position = UDim2.fromOffset(4, 21),
        Font = Enum.Font.GothamBold,
        TextSize = 11,
        TextXAlignment = Enum.TextXAlignment.Center,
        TextColor3 = textColor or Palette.TextWhite,
        ZIndex = 5
    })

    cardBtn.MouseEnter:Connect(function()
        TweenService:Create(cardBtn, TweenInfo.new(0.14), { BackgroundTransparency = 0.1 }):Play()
    end)

    cardBtn.MouseLeave:Connect(function()
        TweenService:Create(cardBtn, TweenInfo.new(0.14), { BackgroundTransparency = 0 }):Play()
    end)

    return cardBtn
end

