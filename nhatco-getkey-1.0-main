local function ShowRobloxToast(title, message, accentColor, duration)
    local dur = duration or 2.8
    local color = accentColor or Palette.CyanBright

    local toast = Create("Frame", {
        Name = "ToastItem",
        Size = UDim2.new(1, 0, 0, 68),
        Position = UDim2.new(1.15, 0, 1, -76),
        BackgroundColor3 = Palette.ToastBg,
        BackgroundTransparency = 0.06,
        BorderSizePixel = 0,
        ClipsDescendants = true,
        ZIndex = 12
    }, ToastContainer)
    AddCorner(toast, 14)

    local leftBar = Create("Frame", {
        Size = UDim2.new(0, 4, 0.72, 0),
        Position = UDim2.new(0, 8, 0.14, 0),
        BackgroundColor3 = color,
        BorderSizePixel = 0,
        ZIndex = 13
    }, toast)
    AddCorner(leftBar, 4)

    CreateIconImage(toast, 36, UDim2.fromOffset(18, 16), 13, 10)

    AddLabel(toast, {
        Text = title,
        Size = UDim2.new(1, -68, 0, 20),
        Position = UDim2.fromOffset(62, 12),
        Font = Enum.Font.GothamBold,
        TextSize = 13,
        TextColor3 = color,
        ZIndex = 13
    })

    AddLabel(toast, {
        Text = message,
        Size = UDim2.new(1, -68, 0, 30),
        Position = UDim2.fromOffset(62, 31),
        Font = Enum.Font.Gotham,
        TextSize = 11,
        TextWrapped = true,
        TextColor3 = Palette.TextSoft,
        ZIndex = 13
    })

    local progressBg = Create("Frame", {
        Size = UDim2.new(1, -16, 0, 3),
        Position = UDim2.new(0, 8, 1, -6),
        BackgroundColor3 = Palette.CardBg,
        BackgroundTransparency = 0.2,
        BorderSizePixel = 0,
        ZIndex = 13
    }, toast)
    AddCorner(progressBg, 3)

    local progressFill = Create("Frame", {
        Size = UDim2.fromScale(1, 1),
        BackgroundColor3 = color,
        BorderSizePixel = 0,
        ZIndex = 14
    }, progressBg)
    AddCorner(progressFill, 3)

    local enterTween = TweenService:Create(toast, TweenInfo.new(0.28, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
        Position = UDim2.new(0, 0, 1, -76)
    })
    enterTween:Play()

    local barTween = TweenService:Create(progressFill, TweenInfo.new(dur, Enum.EasingStyle.Linear), {
        Size = UDim2.new(0, 0, 1, 0)
    })
    barTween:Play()

    task.delay(dur, function()
        if not toast or not toast.Parent then return end
        local exitTween = TweenService:Create(toast, TweenInfo.new(0.24, Enum.EasingStyle.Quint, Enum.EasingDirection.In), {
            Position = UDim2.new(1.2, 0, 1, -76),
            BackgroundTransparency = 1
        })
        exitTween:Play()
        exitTween.Completed:Connect(function()
            if toast then
                toast:Destroy()
            end
        end)
    end)
end

local MemoryStartTimes = {}
local TIMED_SAVE_FILE = "NhatCo_TimedKeys.json"
local SESSION_SAVE_FILE = "NhatCo_SavedSession.json"

local function ReadJsonFile(fileName)
    if type(isfile) == "function" and type(readfile) == "function" then
        local okExists, exists = pcall(isfile, fileName)
        if okExists and exists then
            local okRead, raw = pcall(readfile, fileName)
            if okRead and type(raw) == "string" and raw ~= "" then
                local okDecode, decoded = pcall(function()
                    return HttpService:JSONDecode(raw)
                end)
                if okDecode and type(decoded) == "table" then
                    return decoded
                end
            end
        end
    end
    return nil
end

local function WriteJsonFile(fileName, dataTable)
    if type(writefile) == "function" then
        pcall(function()
            writefile(fileName, HttpService:JSONEncode(dataTable))
        end)
    end
end

local SavedStartTimes = ReadJsonFile(TIMED_SAVE_FILE) or {}

local function SaveStartTime(keyStr, startTs)
    MemoryStartTimes[keyStr] = startTs
    SavedStartTimes[keyStr] = startTs
    WriteJsonFile(TIMED_SAVE_FILE, SavedStartTimes)
end

local function GetStartTime(keyStr)
    if SavedStartTimes[keyStr] then
        return tonumber(SavedStartTimes[keyStr])
    end
    if MemoryStartTimes[keyStr] then
        return tonumber(MemoryStartTimes[keyStr])
    end
    return nil
end

local function SaveVerifiedSession(keyStr)
    local cleaned = Trim(keyStr)
    if cleaned == "" or cleaned == "..." then return end

    local env = (type(getgenv) == "function" and getgenv()) or _G
    env.NHATCO_SAVED_KEY = cleaned

    WriteJsonFile(SESSION_SAVE_FILE, {
        SavedKey = cleaned,
        SavedAt = os.time(),
        UserId = Player.UserId
    })
end

local function ClearSavedSession()
    local env = (type(getgenv) == "function" and getgenv()) or _G
    env.NHATCO_SAVED_KEY = nil

    if type(delfile) == "function" and type(isfile) == "function" then
        local ok, exists = pcall(isfile, SESSION_SAVE_FILE)
        if ok and exists then
            pcall(delfile, SESSION_SAVE_FILE)
        end
    else
        WriteJsonFile(SESSION_SAVE_FILE, {})
    end
end

local function LoadSavedSessionKey()
    local env = (type(getgenv) == "function" and getgenv()) or _G
    if HasValue(env.NHATCO_SAVED_KEY) then
        return Trim(env.NHATCO_SAVED_KEY)
    end

    local data = ReadJsonFile(SESSION_SAVE_FILE)
    if data and HasValue(data.SavedKey) then
        return Trim(data.SavedKey)
    end
    return nil
end

local function ParseExpireTimestamp(expiresAt)
    if type(expiresAt) == "number" then
        return expiresAt
    end
    if type(expiresAt) ~= "string" then
        return nil
    end
    local clean = Trim(expiresAt)
    if clean == "" or clean == "..." then
        return nil
    end
    local num = tonumber(clean)
    if num then
        return num
    end

    local y, m, d, H, M, S = clean:match("^(%d%d%d%d)%-(%d%d)%-(%d%d)%s+(%d%d):(%d%d):(%d%d)$")
    if y then
        return os.time({
            year = tonumber(y),
            month = tonumber(m),
            day = tonumber(d),
            hour = tonumber(H),
            min = tonumber(M),
            sec = tonumber(S)
        })
    end
    return nil
end

local function FormatRemaining(secondsLeft)
    if secondsLeft <= 0 then
        return "0s"
    end
    local days = math.floor(secondsLeft / 86400)
    local hours = math.floor((secondsLeft % 86400) / 3600)
    local mins = math.floor((secondsLeft % 3600) / 60)
    local secs = math.floor(secondsLeft % 60)

    if days > 0 then
        return string.format("%dd %dh %dm", days, hours, mins)
    elseif hours > 0 then
        return string.format("%dh %dm", hours, mins)
    elseif mins > 0 then
        return string.format("%dm %ds", mins, secs)
    else
        return string.format("%ds", secs)
    end
end

local function EvaluateTimedKey(entry, nowTs)
    if type(entry) ~= "table" or not HasValue(entry.Key) then
        return nil
    end

    local keyVal = Trim(entry.Key)
    local label = HasValue(entry.Label) and Trim(entry.Label) or "TIMED"
    local durationSec = (tonumber(entry.DurationDays) or 0) * 86400 + (tonumber(entry.DurationHours) or 0) * 3600
    local expireTs = ParseExpireTimestamp(entry.ExpiresAt)

    if durationSec > 0 then
        local startTs = GetStartTime(keyVal)
        if not startTs then
            startTs = nowTs
            SaveStartTime(keyVal, startTs)
        end
        local durationExpire = startTs + durationSec
        if not expireTs or durationExpire < expireTs then
            expireTs = durationExpire
        end
    end

    if expireTs then
        local left = expireTs - nowTs
        if left <= 0 then
            return {
                valid = false,
                expired = true,
                tier = label,
                detail = "Key thoi gian da het han"
            }
        end
        return {
            valid = true,
            expired = false,
            tier = label,
            detail = "Con lai: " .. FormatRemaining(left)
        }
    end

    return {
        valid = true,
        expired = false,
        tier = label,
        detail = "Key thoi gian hop le"
    }
end

local function CheckKeyValid(inputKey)
    local cleaned = Trim(inputKey)
    if cleaned == "" or cleaned == "..." then
        return false, nil, "Chua nhap key"
    end

    if HasValue(CONFIG.Keys.PremiumKey) and cleaned == Trim(CONFIG.Keys.PremiumKey) then
        return true, "PREMIUM", "Key Premium hop le"
    end

    if HasValue(CONFIG.Keys.FreeKey) and cleaned == Trim(CONFIG.Keys.FreeKey) then
        return true, "FREE", "Key Free hop le"
    end

    if type(CONFIG.Keys.ExtraKeys) == "table" then
        for _, k in ipairs(CONFIG.Keys.ExtraKeys) do
            if HasValue(k) and cleaned == Trim(k) then
                return true, "EXTRA", "Key hop le"
            end
        end
    end

    if type(CONFIG.Keys.TimedKeys) == "table" then
        local nowTs = os.time()
        for _, entry in ipairs(CONFIG.Keys.TimedKeys) do
            if type(entry) == "table" and HasValue(entry.Key) and cleaned == Trim(entry.Key) then
                local res = EvaluateTimedKey(entry, nowTs)
                if res then
                    if res.valid then
                        return true, res.tier, res.detail
                    else
                        return false, "EXPIRED", res.detail
                    end
                end
            end
        end
    end

    return false, "INVALID", "Key khong hop le"
end

local function RunLuaCode(codeString, label)
    if type(loadstring) ~= "function" then
        ShowRobloxToast(
            CONFIG.Name .. " - Canh bao",
            "Moi truong khong ho tro loadstring (" .. label .. ")",
            Palette.Error,
            3.5
        )
        return false
    end

    local compiled, compileErr = loadstring(codeString)
    if not compiled then
        warn("[" .. CONFIG.Name .. "] Loi bien dich " .. label .. ": " .. tostring(compileErr))
        ShowRobloxToast(
            CONFIG.Name .. " - Loi ma",
            "Khong the bien dich ma nguon",
            Palette.Error,
            3.5
        )
        return false
    end

    local ok, runErr = pcall(compiled)
    if not ok then
        warn("[" .. CONFIG.Name .. "] Loi thuc thi " .. label .. ": " .. tostring(runErr))
        ShowRobloxToast(
            CONFIG.Name .. " - Loi thuc thi",
            "Da xay ra loi khi khoi chay",
            Palette.Error,
            3.5
        )
        return false
    end

    return true
end

local function ExecuteNextScript()
    local cfg = CONFIG.NextScript

    if type(cfg.DirectScript) == "function" then
        pcall(cfg.DirectScript)
        return
    elseif HasValue(cfg.DirectScript) then
        RunLuaCode(Trim(cfg.DirectScript), "DirectScript")
        return
    end

    if HasValue(cfg.LoadstringUrl) then
        local url = Trim(cfg.LoadstringUrl)
        local ok, src = pcall(function()
            return game:HttpGet(url)
        end)
        if ok and type(src) == "string" and src ~= "" then
            RunLuaCode(src, "LoadstringUrl")
        else
            ShowRobloxToast(
                CONFIG.Name .. " - Loi tai",
                "Khong tai duoc du lieu tu duong dan",
                Palette.Error,
                3.5
            )
        end
        return
    end

    if HasValue(cfg.RawScriptUrl) then
        local rawUrl = Trim(cfg.RawScriptUrl)
        local ok, rawContent = pcall(function()
            return game:HttpGet(rawUrl)
        end)
        if ok and type(rawContent) == "string" and rawContent ~= "" then
            RunLuaCode(rawContent, "RawScriptUrl")
        else
            ShowRobloxToast(
                CONFIG.Name .. " - Loi Raw",
                "Khong doc duoc noi dung raw",
                Palette.Error,
                3.5
            )
        end
        return
    end

    if type(cfg.DefaultAction) == "function" then
        pcall(cfg.DefaultAction)
    end
end

if CONFIG.AutoLogin then
    local savedKey = LoadSavedSessionKey()
    if savedKey then
        local validSaved, tierSaved, detailSaved = CheckKeyValid(savedKey)
        if validSaved then
            ShowRobloxToast(
                CONFIG.Name .. " - Tu dong dang nhap",
                tierSaved .. " - " .. detailSaved,
                Palette.Success,
                3.0
            )
            ExecuteNextScript()
            return
        else
            ClearSavedSession()
            if tierSaved == "EXPIRED" then
                ShowRobloxToast(
                    CONFIG.Name .. " - Key da luu het han",
                    detailSaved .. " Vui long nhap key moi",
                    Palette.Error,
                    3.0
                )
            end
        end
    end
end

